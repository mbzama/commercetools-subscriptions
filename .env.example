# Copy to .env and fill in your values.
# Used by scripts/create.sh and scripts/destroy.sh.
# Never commit .env to source control.

# ── commercetools ─────────────────────────────────────────────────────────────
CT_CLIENT_ID=your-client-id
CT_CLIENT_SECRET=your-client-secret
CT_PROJECT_KEY=ps-ecomm-dev1
CT_AUTH_URL=https://auth.us-east-2.aws.commercetools.com
CT_API_URL=https://api.us-east-2.aws.commercetools.com

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=your-aws-account-id
AWS_REGION=us-east-2

# ── Subscription ──────────────────────────────────────────────────────────────
SUBSCRIPTION_KEY=orders-dev1
