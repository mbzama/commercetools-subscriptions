# Copy this file to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars to source control.
# CT secrets are NOT stored here — use scripts/create-ct-subscription.sh instead.

# ── AWS ──────────────────────────────────────────────────────────────────────
aws_region     = "us-east-2"
aws_account_id = "123456789012"
environment    = "dev"

# ── commercetools ─────────────────────────────────────────────────────────────
ct_project_key = "ps-ecomm-dev1"

# ── Subscription ──────────────────────────────────────────────────────────────
# Must match the key used in scripts/create-ct-subscription.sh
# Becomes the partner event source suffix:
#   aws.partner/commercetools.com/<ct_project_key>/<subscription_key>
subscription_key = "orders-dev1"
